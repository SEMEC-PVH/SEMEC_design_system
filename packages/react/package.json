{
  "name": "@semec/ds",
  "version": "1.0.0",
  "private": false,
  "description": "Design System SEMEC: componentes React + tokens CSS + artefatos para agentes IA.",
  "type": "module",
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/tokens.css": "./dist/react/tokens.css",
    "./react/shadcn.css": "./dist/react/shadcn.css",
    "./react/pv-preset": {
      "types": "./dist/react/pv-preset.d.ts",
      "import": "./dist/react/pv-preset.js"
    },
    "./react/pv-preset.ts": "./pv-preset.ts",
    "./react/server": {
      "types": "./dist/react/server.d.ts",
      "import": "./dist/react/server.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "import": "./dist/skills/index.js"
    },
    "./skills/llms.txt": "./dist/skills/llms.txt",
    "./skills/llms-full.txt": "./dist/skills/llms-full.txt",
    "./skills/manifest.json": "./dist/skills/manifest.json",
    "./skills/manifest.js": "./dist/skills/manifest.js",
    "./skills/components/*": "./dist/skills/components/*"
  },
  "files": [
    "dist",
    "src",
    "tokens.css",
    "shadcn.css",
    "pv-preset.ts",
    "manifest.js",
    "server.js"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/build-skills.mjs",
    "build:react": "tsup",
    "build:skills": "node scripts/build-skills.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SEMEC/design-system.git",
    "directory": "packages/react"
  },
  "homepage": "https://semec.github.io/design-system",
  "bugs": {
    "url": "https://github.com/SEMEC/design-system/issues"
  },
  "license": "MIT",
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "radix",
    "shadcn",
    "semec",
    "portovelho"
  ]
}
