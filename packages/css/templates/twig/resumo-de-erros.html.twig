{#- Parcial "resumo-de-erros" (Twig). Uso:
    {% include '@semec/resumo-de-erros.html.twig' with {erros: [{campo: 'email', mensagem: 'Informe um e-mail válido.'}]} only %}
    Sem erros, não imprime nada. -#}
{%- autoescape 'html' -%}
{% if erros|default([]) is not empty -%}
{%- set id = id|default('resumo-de-erros') -%}
{%- set focar = focar is not defined or focar is null or focar -%}
<div id="{{ id }}" class="semec-error-summary" role="alert" tabindex="-1" aria-labelledby="{{ id }}-titulo"{% if focar %} autofocus{% endif %}>
  <h2 id="{{ id }}-titulo" class="semec-error-summary__title">{{ titulo|default('Há um problema') }}</h2>
  <ul class="semec-error-summary__list">
{% for erro in erros %}
    <li><a href="#{{ erro.campo ?? '' }}">{{ erro.mensagem ?? '' }}</a></li>
{% endfor %}
  </ul>
</div>
{% endif -%}
{%- endautoescape -%}
