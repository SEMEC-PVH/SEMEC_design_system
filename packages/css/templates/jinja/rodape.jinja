{#- Parcial "rodape" (Jinja2). Uso:
    {% from "semec/rodape.jinja" import rodape %}
    {{ rodape(secoes=[{"titulo": "Serviços", "links": [{"href": "/matricula", "texto": "Matrícula"}]}]) }} -#}
{%- macro rodape(secoes=none, texto_final=none) -%}
{%- autoescape true -%}
<footer class="semec-footer">
{%- if secoes %}
  <div class="semec-footer__content">
{%- for secao in secoes %}
    <div class="semec-footer__section">
      <h2 class="semec-footer__title">{{ secao.titulo | default('') }}</h2>
      <ul class="semec-footer__links">
{%- for link in secao.links | default([]) %}
        <li><a href="{{ link.href | default('') }}" class="semec-footer__link">{{ link.texto | default('') }}</a></li>
{%- endfor %}
      </ul>
    </div>
{%- endfor %}
  </div>
{%- endif %}
  <div class="semec-footer__bottom">{{ texto_final or 'Prefeitura de Porto Velho · SEMEC' }}</div>
</footer>
{%- endautoescape -%}
{%- endmacro -%}
