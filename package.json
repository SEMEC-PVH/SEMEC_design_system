{
  "name": "semec-design-system",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo do Design System SEMEC: kit semec-ds + site de documentação + artefatos para agentes.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @semec/docs",
    "prebuild": "npm run build:ds",
    "build": "npm run build --workspace @semec/docs",
    "build:ds": "npm run build --workspace @semec/ds",
    "start": "npm run start --workspace @semec/docs",
    "lint": "npm run lint --workspace @semec/docs",
    "typecheck": "npm run typecheck --workspace @semec/ds",
    "test": "npm run test --workspace @semec/ds",
    "generate:llms": "npm run build:skills --workspace @semec/ds",
    "proto:css": "npm run proto:css --workspace @semec/docs",
    "clean": "npm run clean --workspace @semec/ds",
    "gate": "npm run build:ds && node scripts/gate/gate.mjs",
    "changeset": "changeset",
    "changeset:check": "changeset status --since=origin/main",
    "check:artifacts": "npm run generate:llms && git diff --exit-code --stat -I generatedAt -I \"^> Gerado \" -- apps/docs/public packages/react/README.md",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run build:ds && changeset publish",
    "test:visual": "playwright test -c playwright.visual.config.mjs",
    "test:visual:update": "playwright test -c playwright.visual.config.mjs --update-snapshots"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.27.7",
    "jsdom": "^30.1.2",
    "playwright": "1.56.1",
    "vite": "^8.3.4"
  }
}
